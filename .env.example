# ============================================================================
# Файл: .env.example — ШАБЛОН конфигурации бота
#
# Это НЕ рабочий файл, а образец без реальных секретов.
#
# КАК ЗАПУСТИТЬ:
#   1. Скопируйте шаблон в рабочий файл:
#        cp .env.example .env
#
#   2. Откройте .env текстовым редактором и замените плейсхолдеры
#      (YOUR_TELEGRAM_BOT_TOKEN_HERE) на свои реальные токены.
#
#   3. Запустите бота (нужен установленный Go):
#        go run .
#
# ВАЖНО:
#   - .env содержит секреты и НЕ попадает в git (он в .gitignore).
#   - .env.example можно и нужно коммитить — в нём нет реальных ключей.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ТОКЕН TELEGRAM БОТА (ОБЯЗАТЕЛЬНО — без него бот не запустится)
# ----------------------------------------------------------------------------
# Где получить:
#   - Откройте Telegram и найдите @BotFather
#   - Отправьте команду:  /newbot
#   - В ответ BotFather пришлёт токен вида:  1234567890:AAHxxx...
#   - Скопируйте токен сюда вместо плейсхолдера
#
# Если токен утёк — перевыпустите его у BotFather командой /revoke
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ----------------------------------------------------------------------------
# 2. КЛЮЧ API trace.moe (ОПЦИОНАЛЬНО — можно оставить пустым)
# ----------------------------------------------------------------------------
# trace.moe — запасной сервис распознавания аниме по скриншоту (используется,
# когда нейросеть AnimeTrace не нашла персонажа).
#   Без ключа: лимит ~10 запросов в минуту на IP.
#   С ключом:  лимиты выше и приоритетная обработка.
# Где получить:
#   - Зайдите на https://trace.moe и зарегистрируйтесь
#   - В личном кабинете найдите свой API-ключ и вставьте его ниже
# Оставьте пустым, если ключ не нужен.
#
# ВНИМАНИЕ: сюда нужно вставлять ИМЕННО ключ, а не URL сервиса.
TRACEMOE_API_KEY=

# ----------------------------------------------------------------------------
# 3. АРХЕТИП ПЕРСОНАЖА (ОПЦИОНАЛЬНАЯ ФУНКЦИЯ — true/false)
# ----------------------------------------------------------------------------
# Определение архетипа характера ("Tsundere", "Kuudere", "Yandere" и т.п.)
# по биографии персонажа. По умолчанию включено.
#   true  — показывать архетип в карточках персонажей
#   false — скрыть архетип (функция отключена)
ARCHETYPE_ENABLED=true