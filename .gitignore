# ============================================================================
# .gitignore — что Git НЕ должен коммитить.
#
# Главная цель: API-ключи и токены не должны попасть в репозиторий.
# Работает как для локального запуска, так и для docker/docker-compose.
# ============================================================================

# --- Файлы с секретами (НИКОГДА не коммитить) ---
# .env и любые его варианты (.env.local, .env.production, *.env ...) содержат
# токены и ключи API. Шаблон .env.example (без секретов) коммитить можно.
.env
.env.*
!.env.example
*.env
!*.env.example

# --- Скомпилированные бинарники Go ---
anime-scanner-bot
anime-scanner-bot.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- Зависимости Go ---
vendor/

# --- Данные и временные файлы ---
tmp/
temp/
*.tmp
*.bak

# --- Логи ---
*.log
logs/

# --- Docker: переопределения и локальные данные (чтобы не напороться
#     на env в compose и не коммитить тома) ---
docker-compose.override.yml
.docker/
data/

# --- IDE и редакторы ---
.idea/
.vscode/
*.swp
*.swo
*~
.classpath
.project
.settings/

# --- Системные файлы ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini