# ============================================================================
# .dockerignore — что НЕ попадает в build context Docker (и в слои образа).
# Главная цель: API-ключи и токены не должны попасть в образ.
# ============================================================================

# --- Секреты: реальный .env и любые его варианты ---
# .env, .env.local, .env.docker, .env.production... — всё исключается.
# Шаблон .env.example тоже не нужен в образе (см. инструкцию сборки).
.env
.env.*
*.env

# --- Скомпилированные бинарники и временные файлы ---
anime-scanner-bot
anime-scanner-bot.exe
tmp/
temp/
*.log
*.tmp

# --- Git и прочие служебные файлы (не нужны в контексте сборки) ---
.git/
.gitignore
idea/
.vscode/